NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — powers the km-radius delivery distance lookup
# (Geocoding API + Distance Matrix API). Never expose this with a
# NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_SERVER_API_KEY=

# Client-side — will power the address-confirmation map on checkout once
# that feature is built. Safe to expose to the browser (restrict it by
# HTTP referrer in Google Cloud instead).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Canonical site URL (optional). Falls back to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=

# --- WhatsApp bot (Evolution API) — see docs/whatsapp-evolution-setup.md ---
# Server-side only. Service role key bypasses RLS: never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL of your Evolution API server, e.g. https://1-2-3-4.sslip.io
EVOLUTION_API_URL=
# Must match AUTHENTICATION_API_KEY on the Evolution server.
EVOLUTION_API_KEY=
# Any long random string; Evolution sends it back on every webhook call.
WHATSAPP_WEBHOOK_SECRET=
